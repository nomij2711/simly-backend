generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  name          String?   @default("SimlyTel User")
  email         String    @unique
  phone         String?
  password      String?
  avatarUrl     String?
  authProvider  String    @default("email") // "email", "google", "apple", "phone", "guest"
  walletBalance Float     @default(10.0)
  isVerified    Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedReason String?   // "user_self_erase", "admin_deleted", etc.
  riskScore     Int       @default(0)       // 0 to 100 risk calculation
  riskLevel     String    @default("LOW")   // "LOW", "MEDIUM", "HIGH"
  isBanned      Boolean   @default(false)   // true = permanently locked
  banReason     String?                     // Admin/system ban explanation
  lastLoginIp   String?                     // Last known IP address
  deviceId      String?                     // Hardware fingerprint
  createdAt     DateTime  @default(now())
}

model OtpCode {
  id        String   @id @default(uuid())
  target    String   // phone number or email address
  code      String
  type      String   @default("login") // "login", "signup", "forgot_password"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PurchasedNumber {
  id                   String    @id @default(uuid())
  phoneNumber          String
  userId               String
  countryCode          String    @default("US")
  status               String    @default("active") // "active", "expiring_soon", "expired"
  planType             String    @default("30_days") // "7_days", "30_days", "365_days"
  profileName          String?   @default("My Line")
  dndEnabled           Boolean   @default(false)
  callForwardingNumber String?
  autoReplyText        String?
  voicemailEnabled     Boolean   @default(true)
  voicemailGreeting    String?   @default("Please leave your message after the tone.")
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
}

model Message {
  id              String   @id @default(uuid())
  fromNumber      String
  toNumber        String
  text            String
  direction       String   // "inbound" or "outbound"
  status          String   @default("delivered") // "sent", "delivered", "received", "failed"
  telnyxMessageId String?
  createdAt       DateTime @default(now())
}

model CallLog {
  id              String   @id @default(uuid())
  myNumber        String
  contactNumber   String
  direction       String   // "outbound" or "inbound"
  status          String   @default("completed") // "completed", "missed", "declined", "busy"
  durationSeconds Int      @default(0)
  hasRecording    Boolean  @default(false)
  recordingUrl    String?
  createdAt       DateTime @default(now())
}

model Voicemail {
  id              String   @id @default(uuid())
  myNumber        String
  contactNumber   String
  audioUrl        String
  durationSeconds Int      @default(0)
  isRead          Boolean  @default(false)
  transcription   String?
  createdAt       DateTime @default(now())
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("android") // "ios" or "android"
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String   @default("user_demo_1")
  type        String   // "topup", "number_purchase", "call_charge", "sms_charge"
  amount      Float
  description String
  createdAt   DateTime @default(now())
}

model SupportMessage {
  id         String   @id @default(uuid())
  userId     String   @default("user_demo_1")
  sender     String   // "user" or "agent"
  senderName String?  @default("Sarah (Support Agent)")
  text       String
  createdAt  DateTime @default(now())
}

model Announcement {
  id               String    @id @default(uuid())
  title            String
  message          String
  imageUrl         String?
  buttonText       String?   @default("Claim Offer Now")
  actionType       String    @default("navigate_numbers") // "none", "open_url", "navigate_numbers", "navigate_wallet"
  actionUrl        String?
  bannerType       String    @default("modal_popup") // "modal_popup", "top_strip"
  displayFrequency String    @default("once_per_session") // "once_ever", "once_per_session", "always"
  isActive         Boolean   @default(true)
  targetAudience   String    @default("all") // "all", "active_only"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model StaffUser {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            String    @default("support_agent") // "super_admin", "support_agent", "operations_manager", "finance_manager"
  permissions     String    @default("all") // JSON or comma-separated permissions
  avatarUrl       String?
  isActive        Boolean   @default(true)
  isOnline        Boolean   @default(false)
  lastLoginAt     DateTime?
  ticketsResolved Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SupportTicket {
  id                String    @id @default(uuid())
  userId            String    @unique
  userName          String?   @default("SimlyTel User")
  userEmail         String?
  status            String    @default("unassigned") // "unassigned", "in_progress", "resolved", "closed"
  priority          String    @default("normal") // "normal", "urgent"
  assignedStaffId   String?
  assignedStaffName String?
  claimedAt         DateTime?
  resolvedAt        DateTime?
  lastMessageText   String?
  lastMessageSender String?   // "user" or "agent"
  lastMessageAt     DateTime  @default(now())
  unreadUserCount   Int       @default(0)
  unreadStaffCount  Int       @default(0)
  internalNotes     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  staffId     String?
  staffName   String   @default("System / Master Admin")
  staffEmail  String   @default("owner@simlytel.com")
  staffRole   String   @default("super_admin")
  action      String   // "STAFF_LOGIN", "REPLY_SUPPORT", "CLAIM_TICKET", "TRANSFER_TICKET", "RESOLVE_TICKET", "ADJUST_BALANCE", "EXTEND_NUMBER", "TOGGLE_NUMBER_STATUS", "SEND_BROADCAST", "CREATE_STAFF", "SUSPEND_STAFF", "UPDATE_PRICING", "DELETE_RECORD", "BAN_USER", "UNBAN_USER", "ADD_BLACKLIST", "REMOVE_BLACKLIST", "UPDATE_CONFIG", "UPDATE_ALERTS"
  targetId    String?
  targetType  String?  // "user", "ticket", "number", "staff", "system", "config", "blacklist"
  details     String?
  ipAddress   String?  @default("127.0.0.1")
  createdAt   DateTime @default(now())
}

model Blacklist {
  id          String   @id @default(uuid())
  type        String   // "EMAIL", "IP", "DEVICE_ID", "PHONE"
  value       String   // e.g., "badactor@tempmail.com", "185.220.101.5", "device_fingerprint_xyz"
  reason      String   // "Card Testing Fraud", "DDoS Attempt", "Abusive User"
  createdBy   String   @default("System Admin")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique // "maintenance_mode", "min_app_version", "allow_outbound_calls", etc.
  value       String   // "true", "1.2.0", "enabled"
  description String?  // Description of this configuration parameter
  updatedBy   String?  @default("Super Admin")
  updatedAt   DateTime @updatedAt
}

model AdminAlertSetting {
  id                        String   @id @default(uuid())
  primaryChannel            String   @default("EMAIL") // "EMAIL", "SMS", "WHATSAPP", "TELEGRAM", "DISCORD", "IN_APP"
  ownerEmail                String?  @default("admin@simlytel.com")
  ownerPhone                String?
  webhookUrl                String?
  telegramBotToken          String?
  telegramChatId            String?
  notifyOnLargeDeposit      Boolean  @default(true)
  notifyOnLowCarrierBalance Boolean  @default(true)
  notifyOnHighRiskFraud     Boolean  @default(true)
  notifyOnUnassignedTicket  Boolean  @default(true)
  isEnabled                 Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}
